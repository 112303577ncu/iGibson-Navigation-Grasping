# Generated / dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.next/
dist/
build/
.cache/

# Agent/IDE local hidden folders
.agents/
.claude/
.codebase-memory/

# Local secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Large binary/media artifacts
*.mp3
*.mp4
*.mov
*.avi
*.mkv
*.7z
*.rar
*.pt
*.pth
*.onnx
*.ckpt

# Exclude torch weights by default except the YOLO models the project ships.
# Each is ~5 MB, well under GitHub's limits -- no LFS needed.
# (*.pt.bak rollback copies are not matched by *.pt, so they track as-is.)
!detection/models/*.pt
!yolo/**/*.pt

# Exclude zip by default except trained models.
# This rule fails SILENTLY: git status never mentions a model you forgot to
# except, so a "committed" model pair can be missing on the next clone. After
# adding a model, confirm the .zip really appears in `git show --stat`.
*.zip
!grasp/trained_6d_models_v17/*.zip
!grasp/trained_6d_models_v18/*.zip
!grasp/v21/models/*.zip
!integration/nav_best_model/*.zip
