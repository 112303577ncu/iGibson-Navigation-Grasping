<launch>
  <!-- Depth-only diagnostic: no RGB reader, point cloud, base TF or motion. -->
  <include file="$(find astra_camera)/launch/astraproplus.launch">
    <arg name="camera_name" value="rear_depth_probe"/>
    <arg name="enable_color" value="false"/>
    <arg name="use_uvc_camera" value="false"/>
    <arg name="enable_ir" value="false"/>
    <arg name="enable_depth" value="true"/>
    <arg name="depth_width" value="320"/>
    <arg name="depth_height" value="240"/>
    <arg name="depth_fps" value="30"/>
    <arg name="enable_point_cloud" value="false"/>
    <arg name="enable_point_cloud_xyzrgb" value="false"/>
    <arg name="depth_align" value="false"/>
    <arg name="publish_tf" value="false"/>
  </include>
</launch>
