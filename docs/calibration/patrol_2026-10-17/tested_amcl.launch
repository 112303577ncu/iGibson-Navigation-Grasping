<launch>
<node pkg="map_server" type="map_server" name="box_map_server" args="/home/jetson/Documents/deploy_jetson2/maps/demo_box_20261017/demo_box.yaml"/>
<node pkg="amcl" type="amcl" name="amcl" output="screen">
<param name="use_map_topic" value="true"/><param name="odom_model_type" value="omni"/>
<param name="min_particles" value="300"/><param name="max_particles" value="1000"/>
<param name="laser_max_beams" value="60"/><param name="laser_max_range" value="3.0"/>
<param name="base_frame_id" value="base_footprint"/><param name="odom_frame_id" value="odom"/><param name="global_frame_id" value="map"/>
<param name="initial_pose_x" value="-0.06211522415621784"/><param name="initial_pose_y" value="0.3090905476774587"/><param name="initial_pose_a" value="-0.3451656723954309"/>
<param name="initial_cov_xx" value="0.01"/><param name="initial_cov_yy" value="0.01"/><param name="initial_cov_aa" value="0.0076"/>
<param name="update_min_d" value="0.05"/><param name="update_min_a" value="0.05"/>
<param name="resample_interval" value="1"/><param name="transform_tolerance" value="0.5"/>
</node></launch>